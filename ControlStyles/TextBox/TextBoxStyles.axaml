<Styles xmlns="https://github.com/avaloniaui"
        xmlns:local="clr-namespace:ControlStyles" xmlns:docs="using:Avalonia.Controls.Documents">

  <Design.PreviewWith>
    <Border Padding="20">
      <StackPanel Spacing="12">
        <local:UiTextBox Text="Testo libero" />
        <local:UiIntegerTextBox Text="123" />
        <local:UiDecimalTextBox Text="123,45" />
        <local:UiEuroTextBox Text="123,45" />
      </StackPanel>
    </Border>
  </Design.PreviewWith>

  <!-- uiTextBox viene aggiunta da UiTextBox e quindi vale anche per i controlli derivati. -->
  <Style Selector="TextBox.uiTextBox">
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="FontFamily" Value="Verdana" />
    <Setter Property="FontSize" Value="16" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Focusable" Value="True" />
    <Setter Property="IsTabStop" Value="True" />
  </Style>

  <Style Selector="TextBox.uiTextBox:focus-within">
    <Setter Property="Foreground" Value="Blue" />
    <Setter Property="FontWeight" Value="Normal" />
  </Style>

  <Style Selector="TextBox.uiTextBox:focus-within /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="White" />
  </Style>

  <Style Selector="TextBox.uiTextBox:disabled">
    <Setter Property="Foreground" Value="White" />
  </Style>

  <Style Selector="TextBox.uiTextBox:disabled /template/ TextPresenter">
    <Setter Property="docs:TextElement.Foreground" Value="White" />
  </Style>

</Styles>
