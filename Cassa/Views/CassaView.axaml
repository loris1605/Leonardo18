<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:ui="using:ControlStyles" xmlns:vm="using:Cassa.ViewModels" xmlns:db="using:AppServices.Database" xmlns:views="using:Cassa.Views" xmlns:icons="using:FluentIcons.Avalonia"
 x:Class="Cassa.Views.CassaView" x:DataType="vm:CassaViewModel"
 Background="LightSteelBlue" KeyboardNavigation.TabNavigation="Cycle">
 <Grid Margin="12">
  <ui:PopupBorder Padding="16" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
    <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="10">
     <Grid x:Name="HeaderGrid" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="8">
      <ui:UiTitolo x:Name="TitleControl" Text="{Binding Title}" SubTitolo="True" FontSize="22" VerticalAlignment="Center"/>
      <ui:UiIconButton x:Name="MenuButton" Grid.Column="1" XLabel="TORNA AL MENU" IconSymbol="Home" IconVariant="Color"
       AutomationProperties.Name="Torna al menu" Command="{Binding MenuCommand}" IsEnabled="{Binding CanBackToMenu}" Padding="12,8"/>
     </Grid>
     <TextBlock Grid.Row="1" Text="{Binding ReceiverStatus}" Foreground="White" FontSize="13"/>
     <Grid Grid.Row="2" IsVisible="{Binding !IsBusy}" IsEnabled="{Binding IsUiReady}">
      <Grid RowDefinitions="Auto,Auto,*" RowSpacing="10" IsVisible="{Binding IsPostazione}">
       <WrapPanel>
        <ui:UiIconButton XLabel="ENTRA SOCIO" IconSymbol="PersonAdd" IconVariant="Color" AutomationProperties.Name="Entra socio"
         Command="{Binding EntraSocioCommand}" Padding="12,8" Margin="0,0,10,8"/>
        <ui:UiIconButton XLabel="ESCE SOCIO" IconSymbol="ArrowRight" IconVariant="Filled" AutomationProperties.Name="Esce socio" Command="{Binding EsceSocioCommand}" IsEnabled="{Binding CanEsceSocio}" Padding="12,8" Margin="0,0,10,8"/>
        <ui:UiIconButton XLabel="SOCI ALL'INTERNO" IconSymbol="PeopleTeam" IconVariant="Color" AutomationProperties.Name="Soci all'interno"
         Command="{Binding ListaSociCommand}" Padding="12,8" Margin="0,0,10,8"/>
        <ui:UiIconButton XLabel="ABBONAMENTI" IconSymbol="TicketDiagonal" IconVariant="Filled" AutomationProperties.Name="Acquisto abbonamenti" ToolTip.Tip="{Binding AvvisoAcquistoAbbonamenti}"
         Command="{Binding AcquistaAbbonamentoCommand}" Padding="12,8" Margin="0,0,10,8"/>
        <ui:UiIconButton XLabel="VEDI FIDELITY" IconSymbol="TicketDiagonal" IconVariant="Filled" AutomationProperties.Name="Vedi Fidelity" Command="{Binding ApriStoricoFidelityCommand}" Padding="12,8" Margin="0,0,10,8"/>
         <ui:UiIconButton XLabel="SOSPESI" IconSymbol="Clipboard" IconVariant="Color" Command="{Binding ApriSospesiCommand}" Padding="12,8" Margin="0,0,10,8"/>
       </WrapPanel>
       <WrapPanel Grid.Row="1">
        <TextBlock Text="POSIZIONE" Foreground="White" VerticalAlignment="Center" Margin="0,0,12,8"/>
        <ui:UiTextBox x:Name="PosizioneBox" Text="{Binding Posizione, Mode=TwoWay}" MaxLength="30" Width="180"
         MoveToNextOnEnter="False" AutomationProperties.Name="Posizione" Margin="0,0,12,8"/>
        <ui:UiIconButton XLabel="APRI SCHEDA" IconSymbol="Clipboard" IconVariant="Color" AutomationProperties.Name="Apri scheda"
         Command="{Binding OpenSheetCommand}" Padding="12,8" Margin="0,0,12,8"/>
        <ui:UiIconButton XLabel="ANNULLA" IconSymbol="DismissCircle" IconVariant="Color" AutomationProperties.Name="Annulla scheda"
         Command="{Binding ClearSheetCommand}" Padding="12,8" Margin="0,0,12,8"/>
       </WrapPanel>
       <Grid x:Name="SheetGrid" Grid.Row="2" ColumnDefinitions="170,*,*" RowDefinitions="Auto,*" ColumnSpacing="14" RowSpacing="10" IsVisible="{Binding HasSheet}">
        <Border x:Name="SheetIdentity" Grid.ColumnSpan="3" Background="#F4F7FA" CornerRadius="8" Padding="10" VerticalAlignment="Top">
         <StackPanel Spacing="6">
          <TextBlock Text="{Binding Sheet.AnagraficaConEta}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"/>
          <WrapPanel>
           <TextBlock Text="{Binding Sheet.Posizione, StringFormat='Posizione: {0}'}" Margin="0,0,20,4"/>
           <TextBlock Text="{Binding Sheet.NumeroTessera, StringFormat='Tessera: {0}'}" Margin="0,0,20,4"/>
           <TextBlock Text="{Binding Sheet.Nascita, StringFormat='Nascita: {0}'}" Margin="0,0,20,4"/>
           <TextBlock Text="{Binding Sheet.CheckinTime, StringFormat='Ingresso: {0:dd/MM/yyyy HH:mm}'}"/>
          </WrapPanel>
          <TextBlock Text="NON ENTRA · ingresso annullato" Foreground="#A02020" FontWeight="Bold" IsVisible="{Binding Sheet.IngressoAnnullato}"/>
            <TextBlock Text="{Binding Sheet.Note}" TextWrapping="Wrap"/>
          <WrapPanel IsVisible="{Binding Sheet.HasSospesi}"><TextBlock Text="{Binding Sheet.AvvisoSospesi}" Foreground="#9A3412" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,12,0"/>
           <ui:UiIconButton XLabel="VEDI SOSPESI" IconSymbol="Clipboard" IconVariant="Color" Command="{Binding ApriSospesiSocioCommand}" CommandParameter="{Binding Sheet.NumeroTessera}" Padding="8,4"/></WrapPanel>
          <TextBlock Text="SCHEDA BLOCCATA · inserimenti e modifiche impediti in tutte le postazioni" FontWeight="Bold" Foreground="#A02020" TextWrapping="Wrap" IsVisible="{Binding Sheet.Blocco}"/>
          <ui:UiIconButton x:Name="SheetLockButton" XLabel="{Binding BloccoSchedaLabel}" IconSymbol="LockClosed" IconVariant="Filled" Command="{Binding SetBloccoSchedaCommand}" IsEnabled="{Binding CanSetBloccoScheda}" Padding="10,6" HorizontalAlignment="Left" AutomationProperties.Name="Blocca o sblocca scheda"/>
         </StackPanel>
        </Border>
        <views:GuardarobaControl x:Name="GuardarobaPanel" IsEnabled="{Binding CanEditSheet}" Grid.Row="1" VerticalAlignment="Top"/>
        <Grid x:Name="SheetAccount" Grid.Row="1" Grid.Column="1" RowDefinitions="Auto,*,Auto" RowSpacing="10" IsEnabled="{Binding !IsPaymentBusy}">
        <TextBlock Text="DETTAGLIO CONTO" Foreground="White" FontWeight="Bold"/>
        <Border Grid.Row="1" Background="#F4F7FA" CornerRadius="8" Padding="12">
         <ScrollViewer x:Name="AccountScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
          <StackPanel MinWidth="760" Spacing="6">
           <Grid ColumnDefinitions="120,130,120,*,90,130" ColumnSpacing="10">
            <Grid.Styles>
             <Style Selector="Button.contoSort">
              <Setter Property="Background" Value="Transparent"/>
              <Setter Property="BorderThickness" Value="0"/>
              <Setter Property="Padding" Value="0,4"/>
              <Setter Property="HorizontalAlignment" Value="Stretch"/>
              <Setter Property="HorizontalContentAlignment" Value="Left"/>
              <Setter Property="FontWeight" Value="Bold"/>
              <Setter Property="FontSize" Value="12"/>
             </Style>
            </Grid.Styles>
            <Button x:Name="SortDataButton" Classes="contoSort" Content="{Binding DataHeader}" Command="{Binding SortContoCommand}"
             CommandParameter="DataOra" AutomationProperties.Name="Ordina per data e ora"/>
            <Button x:Name="SortPostazioneButton" Grid.Column="1" Classes="contoSort" Content="{Binding PostazioneHeader}" Command="{Binding SortContoCommand}"
             CommandParameter="DescPostazione" AutomationProperties.Name="Ordina per postazione"/>
            <Button x:Name="SortSettoreButton" Grid.Column="2" Classes="contoSort" Content="{Binding SettoreHeader}" Command="{Binding SortContoCommand}"
             CommandParameter="DescSettore" AutomationProperties.Name="Ordina per settore"/>
            <Button x:Name="SortDettaglioButton" Grid.Column="3" Classes="contoSort" Content="{Binding DettaglioHeader}" Command="{Binding SortContoCommand}"
             CommandParameter="VoiceDesc" AutomationProperties.Name="Ordina per dettaglio"/>
            <Button x:Name="SortPrezzoButton" Grid.Column="4" Classes="contoSort" Content="{Binding PrezzoHeader}" Command="{Binding SortContoCommand}"
             CommandParameter="VoicePrice" AutomationProperties.Name="Ordina per prezzo"/>
            <Button x:Name="SortStatoButton" Grid.Column="5" Classes="contoSort" Content="{Binding StatoHeader}" Command="{Binding SortContoCommand}"
             CommandParameter="Stato" AutomationProperties.Name="Ordina per stato"/>
           </Grid>
           <ItemsControl ItemsSource="{Binding Conto}">
            <ItemsControl.ItemTemplate>
             <DataTemplate x:DataType="db:CassaConto">
              <StackPanel Classes="contoRow" Margin="0,6" Spacing="3" Background="Transparent" ContextRequested="OnAccountContextRequested">
               <Grid ColumnDefinitions="120,130,120,*,90,130" ColumnSpacing="10">
                <TextBlock Text="{Binding DataOra, StringFormat='{}{0:dd/MM HH:mm}'}"/>
                <TextBlock Grid.Column="1" Text="{Binding DescPostazione}" TextWrapping="Wrap"/>
                <TextBlock Grid.Column="2" Text="{Binding DescSettore}" TextWrapping="Wrap"/>
                <TextBlock Grid.Column="3" Text="{Binding VoiceDesc}" TextWrapping="Wrap"/>
                <TextBlock Grid.Column="4" Text="{Binding VoicePrice, StringFormat='{}{0:0.00} €'}"/>
                <CheckBox Grid.Column="5" IsEnabled="{Binding $parent[UserControl].((vm:CassaViewModel)DataContext).CanEditSheet}" IsChecked="{Binding Pagato, Mode=OneWay}" Content="{Binding Stato}"
                 Command="{Binding $parent[UserControl].((vm:CassaViewModel)DataContext).SetPagamentoCommand}"
                 CommandParameter="{Binding}" ToolTip.Tip="Seleziona per cambiare lo stato del pagamento"
                 AutomationProperties.Name="{Binding VoiceDesc, StringFormat='Pagamento: {0}'}"/>
               </Grid>
               <TextBlock Text="{Binding Note}" Foreground="#536170" FontSize="12" TextWrapping="Wrap"/>
              </StackPanel>
             </DataTemplate>
            </ItemsControl.ItemTemplate>
           </ItemsControl>
          </StackPanel>
         </ScrollViewer>
        </Border>
        <WrapPanel Grid.Row="2">
         <TextBlock Text="{Binding Totale, StringFormat='Totale: {0:0.00} €'}" Foreground="White" FontWeight="Bold" Margin="0,0,24,0"/>
         <TextBlock Text="{Binding DaPagare, StringFormat='Da pagare: {0:0.00} €'}" Foreground="White" FontWeight="Bold" Margin="0,0,20,8"/>
         <ui:UiIconButton x:Name="PayAllButton" XLabel="PAGA TUTTE LE VOCI" IconSymbol="Save" IconVariant="Filled" Command="{Binding PagaTuttoCommand}" IsEnabled="{Binding CanPagaTutto}" Padding="12,8" AutomationProperties.Name="Paga tutte le voci del conto"/>
        </WrapPanel>
        </Grid>
        <Grid x:Name="SheetCharges" IsEnabled="{Binding CanEditSheet}" Grid.Row="1" Grid.Column="2" RowDefinitions="Auto,Auto,*" RowSpacing="10">
         <TextBlock Text="VOCI DI SPESA" Foreground="White" FontWeight="Bold"/>
         <StackPanel Grid.Row="1"><TextBlock Text="Seleziona una voce per addebitarla al conto." Foreground="White" TextWrapping="Wrap"/>
          <CheckBox Content="{Binding CreditoFidelityLabel}" Foreground="White" IsChecked="{Binding UsaCreditoFidelity,Mode=TwoWay}" IsVisible="{Binding HasCreditoFidelity}"/>
         </StackPanel>
         <TextBlock Grid.Row="2" Text="Nessuna voce di spesa configurata per questa postazione." Foreground="White"
          TextWrapping="Wrap" IsVisible="{Binding !HasVociSpesa}"/>
         <TabControl x:Name="SectorTabs" Grid.Row="2" ItemsSource="{Binding SettoriSpesa}" SelectedItem="{Binding SelectedSettoreSpesa, Mode=TwoWay}" IsVisible="{Binding HasVociSpesa}"
          ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled">
          <TabControl.ItemsPanel>
           <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
          </TabControl.ItemsPanel>
          <TabControl.ItemTemplate>
           <DataTemplate x:DataType="vm:CassaSettoreSpesa">
            <TextBlock Text="{Binding Nome}" FontWeight="SemiBold"/>
           </DataTemplate>
          </TabControl.ItemTemplate>
          <TabControl.ContentTemplate>
           <DataTemplate x:DataType="vm:CassaSettoreSpesa">
            <Border BorderBrush="#B9CBDE" BorderThickness="1" CornerRadius="8" Padding="8">
              <ItemsControl ItemsSource="{Binding Voci}" VerticalAlignment="Top">
               <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><UniformGrid Columns="4"/></ItemsPanelTemplate>
               </ItemsControl.ItemsPanel>
               <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="db:CassaVoceSpesa">
                 <ui:UiIconButton
                  Command="{Binding $parent[UserControl].((vm:CassaViewModel)DataContext).AddChargeCommand}"
                  CommandParameter="{Binding}" Padding="6" Margin="4" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                  AutomationProperties.Name="{Binding Label}">
                  <StackPanel Spacing="4">
                   <icons:SymbolIcon Symbol="AddCircle" IconVariant="Color" FontSize="18" HorizontalAlignment="Center"/>
                   <TextBlock Text="{Binding Descrizione}" TextWrapping="Wrap" TextAlignment="Center" FontSize="12"/>
                   <TextBlock Text="{Binding Prezzo, StringFormat='{}{0:0.00} €'}" TextAlignment="Center" FontWeight="SemiBold" FontSize="12"/>
                  </StackPanel>
                 </ui:UiIconButton>
                </DataTemplate>
               </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Border>
           </DataTemplate>
          </TabControl.ContentTemplate>
         </TabControl>
        </Grid>
       </Grid>
      </Grid>
      <Grid ColumnDefinitions="*,*" RowDefinitions="*,Auto,Auto,Auto" ColumnSpacing="18" RowSpacing="10" IsVisible="{Binding IsEntry}">
       <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Spacing="10">
       <TextBlock Text="ACCESSO NUOVO SOCIO" Foreground="White" FontSize="18" FontWeight="Bold"/>
       <WrapPanel>
        <TextBlock Text="TESSERA" Foreground="White" VerticalAlignment="Center" Margin="0,0,12,8"/>
        <ui:UiTextBox x:Name="TesseraBox" Text="{Binding NumeroTessera, Mode=TwoWay}" MaxLength="30" Width="220"
         MoveToNextOnEnter="False" AutomationProperties.Name="Numero tessera" Margin="0,0,12,8"/>
        <ui:UiIconButton XLabel="IDENTIFICA" IconSymbol="PersonKey" IconVariant="Color" AutomationProperties.Name="Identifica socio"
         Command="{Binding FindCardCommand}" Padding="12,8" Margin="0,0,12,8"/>
        <ui:UiIconButton XLabel="AZZERA" IconSymbol="DismissCircle" IconVariant="Color" AutomationProperties.Name="Azzera ingresso"
         Command="{Binding ResetEntryCommand}" Padding="12,8" Margin="0,0,12,8"/>
       </WrapPanel>
       <Border IsVisible="{Binding HasMember}" Background="#F4F7FA" CornerRadius="8" Padding="14">
        <StackPanel Spacing="6">
         <TextBlock Text="{Binding Member.AvvisoBlocco}" IsVisible="{Binding Member.SocioBloccato}" Foreground="#B42318" FontWeight="Bold" TextWrapping="Wrap"/>
         <TextBlock Text="{Binding Member.Anagrafica}" FontSize="20" FontWeight="SemiBold"/>
         <TextBlock Text="{Binding Rientro.Avviso}" IsVisible="{Binding HasRientro}" Foreground="#166534" FontWeight="Bold" TextWrapping="Wrap"/>
         <TextBlock IsVisible="{Binding Member.HasSospesi}" Text="{Binding Member.AvvisoSospesi}" Foreground="#9A3412" FontWeight="Bold" TextWrapping="Wrap"/>
         <ScrollViewer IsVisible="{Binding Member.HasSospesi}" MaxHeight="240" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
          <ItemsControl ItemsSource="{Binding SospesiIngresso}" AutomationProperties.Name="Dettaglio sospesi del socio">
           <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="db:CassaSospeso">
             <Border BorderBrush="#D6DEE6" BorderThickness="0,0,0,1" Padding="0,8">
              <StackPanel Spacing="4">
               <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <StackPanel><TextBlock Text="{Binding DataOra,StringFormat='{}{0:dd/MM/yyyy HH:mm}'}"/><TextBlock Text="{Binding Origine}" FontWeight="SemiBold"/></StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding Importo,StringFormat='{}{0:N2} €'}" FontWeight="Bold" Foreground="#9A3412"/>
               </Grid>
               <TextBlock Text="{Binding Descrizione}" TextWrapping="Wrap"/>
               <TextBlock Text="{Binding Dettaglio}" TextWrapping="Wrap"/>
               <ui:UiIconButton XLabel="SALDA SOSPESO" IconSymbol="Save" IconVariant="Filled" IsVisible="{Binding CanIncassare}"
                Command="{Binding $parent[UserControl].((vm:CassaViewModel)DataContext).IncassaSospesoCommand}" CommandParameter="{Binding}" Padding="10,7" HorizontalAlignment="Left"/>
              </StackPanel>
             </Border>
            </DataTemplate>
           </ItemsControl.ItemTemplate>
          </ItemsControl>
         </ScrollViewer>
         <WrapPanel>
          <TextBlock Text="{Binding Member.NumeroSocio, StringFormat='Codice socio: {0}'}" Margin="0,0,20,4"/>
          <TextBlock Text="{Binding Member.Nascita, StringFormat='Nascita: {0}'}" Margin="0,0,20,4"/>
          <TextBlock Text="{Binding Member.Scadenza, StringFormat='Scadenza tessera: {0}'}"/>
         </WrapPanel>
        </StackPanel>
       </Border>
       <views:FidelityIngressoView/>
       <ui:UiIconButton XLabel="APRI SCHEDA DEL SOCIO" IconSymbol="Clipboard" IconVariant="Color"
        AutomationProperties.Name="Apri scheda del socio" Command="{Binding OpenMemberSheetCommand}"
        IsVisible="{Binding MemberInside}" Padding="12,8" HorizontalAlignment="Left"/>
       </StackPanel></ScrollViewer>
       <Grid Grid.Column="1" RowDefinitions="Auto,160,Auto,*" RowSpacing="10" IsVisible="{Binding ShowIngressi}">
       <TextBlock Text="TARIFFA DI INGRESSO" Foreground="White" FontWeight="Bold"/>
       <ListBox Grid.Row="1" ItemsSource="{Binding Ingressi}" IsEnabled="{Binding CanSelectIngresso}" SelectedItem="{Binding SelectedIngresso, Mode=TwoWay}"
        Background="#F4F7FA" AutomationProperties.Name="Tariffa di ingresso">
        <ListBox.ItemTemplate>
         <DataTemplate x:DataType="db:CassaIngresso">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="20" Margin="4">
           <StackPanel>
            <TextBlock Text="{Binding Label}" FontWeight="SemiBold"/>
            <TextBlock Text="FREE DRINK" IsVisible="{Binding FreeDrink}" FontSize="12"/>
           </StackPanel>
           <TextBlock Grid.Column="1" Text="{Binding Prezzo, StringFormat='{}{0:0.00} €'}" VerticalAlignment="Center"/>
          </Grid>
         </DataTemplate>
        </ListBox.ItemTemplate>
       </ListBox>
       <TextBlock Grid.Row="2" Text="{Binding SceltaIngresso}" Foreground="White" FontWeight="Bold" TextWrapping="Wrap"/>
       <ScrollViewer Grid.Row="3" IsVisible="{Binding HasAbbonamentiIngresso}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <ItemsControl ItemsSource="{Binding AbbonamentiIngresso}" IsEnabled="{Binding CanSelectIngresso}">
         <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:TesseraAbbonamentoViewModel">
           <Border Background="#F8F3E7" BorderBrush="#D7C7A4" BorderThickness="2" CornerRadius="16" Padding="16" Margin="0,0,0,12">
            <StackPanel Spacing="10">
             <TextBlock Text="TESSERA ABBONAMENTO" Foreground="#536B66" FontSize="11" FontWeight="Bold" LetterSpacing="2"/>
             <TextBlock Text="{Binding Nome}" Foreground="#163E38" FontSize="20" FontWeight="Bold" TextWrapping="Wrap"/>
             <TextBlock Text="{Binding Riepilogo}" Foreground="#536B66" TextWrapping="Wrap"/>
             <ItemsControl ItemsSource="{Binding Bollini}">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
               <DataTemplate x:DataType="vm:BollinoIngressoViewModel">
                <StackPanel Width="90" Margin="0,0,8,10" Spacing="5">
                 <Button Width="64" Height="64" CornerRadius="32" BorderThickness="2" HorizontalAlignment="Center"
                  HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Background="{Binding Sfondo}" BorderBrush="{Binding Bordo}"
                  IsEnabled="{Binding Disponibile}" Command="{Binding $parent[UserControl].((vm:CassaViewModel)DataContext).SelezionaBollinoCommand}" CommandParameter="{Binding}"
                  AutomationProperties.Name="{Binding Numero,StringFormat='Bollino abbonamento {0}'}">
                  <TextBlock Text="{Binding Simbolo}" FontSize="24" FontWeight="Bold" Foreground="#163E38"/>
                 </Button>
                 <TextBlock Text="{Binding Stato}" TextAlignment="Center" FontSize="11" Foreground="#475569"/>
                </StackPanel>
               </DataTemplate>
              </ItemsControl.ItemTemplate>
             </ItemsControl>
             <TextBlock Text="Seleziona un bollino disponibile oppure scegli una tariffa di ingresso." Foreground="#536B66" FontSize="11" TextWrapping="Wrap"/>
            </StackPanel>
           </Border>
          </DataTemplate>
         </ItemsControl.ItemTemplate>
        </ItemsControl>
       </ScrollViewer>
       </Grid>
       <Grid Grid.Row="1" Grid.ColumnSpan="2" ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="10" IsVisible="{Binding ShowIngressi}">
        <ui:UiLabelForGrid Text="POSIZIONE:"/>
        <ui:UiTextBox x:Name="IngressoPosizioneBox" Grid.Column="1" Text="{Binding EntryPosition, Mode=TwoWay}"
         MaxLength="30" MoveToNextOnEnter="False" AutomationProperties.Name="Posizione nuovo ingresso"/>
        <ui:UiLabelForGrid Grid.Row="1" Text="NOTE:"/>
        <ui:UiTextBox Grid.Column="1" Grid.Row="1" Text="{Binding Note, Mode=TwoWay}" MaxLength="50"/>
       </Grid>
       <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding EntryWarning}" Foreground="White" TextWrapping="Wrap"/>
       <WrapPanel Grid.Row="3" Grid.ColumnSpan="2">
        <ui:UiIconButton XLabel="REGISTRA INGRESSO" IconSymbol="PersonAdd" IconVariant="Color"
         IsVisible="{Binding ShowIngressi}" AutomationProperties.Name="Registra ingresso" Command="{Binding RegisterEntryCommand}" Padding="12,8" Margin="0,0,12,8"/>
        <ui:UiIconButton XLabel="TORNA ALLA POSTAZIONE" IconSymbol="BuildingStore" IconVariant="Color"
         AutomationProperties.Name="Torna alla postazione" Command="{Binding BackCommand}" Padding="12,8" Margin="0,0,12,8"/>
       </WrapPanel>
      </Grid>
      <Grid RowDefinitions="Auto,Auto,*,Auto,Auto" RowSpacing="10" IsVisible="{Binding IsList}">
       <TextBlock Text="SOCI ALL'INTERNO" Foreground="White" FontSize="18" FontWeight="Bold"/>
       <ui:UiTextBox Grid.Row="1" Text="{Binding SearchText, Mode=TwoWay}" PlaceholderText="Filtra per posizione, nome, tessera o note"/>
       <Border Grid.Row="2" Background="#F4F7FA" CornerRadius="8" Padding="6">
        <ScrollViewer x:Name="ElencoSociScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
         <Grid MinWidth="1400" RowDefinitions="Auto,*">
          <Grid ColumnDefinitions="80,125,125,105,95,150,50,50,50,50,115,90,180" ColumnSpacing="8" Margin="8,4,8,6">
           <Grid.Styles>
            <Style Selector="Button.elencoSort">
             <Setter Property="Background" Value="Transparent"/>
             <Setter Property="BorderThickness" Value="0"/>
             <Setter Property="Padding" Value="0,4"/>
             <Setter Property="HorizontalAlignment" Value="Stretch"/>
             <Setter Property="HorizontalContentAlignment" Value="Left"/>
             <Setter Property="FontWeight" Value="Bold"/>
             <Setter Property="FontSize" Value="11"/>
            </Style>
           </Grid.Styles>
            <Button x:Name="ElencoSortPosizioneButton" Grid.Column="0" Classes="elencoSort" Content="{Binding ElencoPosizioneHeader}" Command="{Binding OrdinaSociCommand}" CommandParameter="Posizione" AutomationProperties.Name="Ordina soci per posizione"/>
            <Button x:Name="ElencoSortCognomeButton" Grid.Column="1" Classes="elencoSort" Content="{Binding ElencoCognomeHeader}" Command="{Binding OrdinaSociCommand}" CommandParameter="Cognome" AutomationProperties.Name="Ordina soci per cognome"/>
            <Button x:Name="ElencoSortNomeButton" Grid.Column="2" Classes="elencoSort" Content="{Binding ElencoNomeHeader}" Command="{Binding OrdinaSociCommand}" CommandParameter="Nome" AutomationProperties.Name="Ordina soci per nome"/>
            <Button x:Name="ElencoSortNumeroTesseraButton" Grid.Column="3" Classes="elencoSort" Content="{Binding ElencoNumeroTesseraHeader}" Command="{Binding OrdinaSociCommand}" CommandParameter="NumeroTessera" AutomationProperties.Name="Ordina soci per tessera"/>
            <Button x:Name="ElencoSortNatoilButton" Grid.Column="4" Classes="elencoSort" Content="{Binding ElencoNatoilHeader}" Command="{Binding OrdinaSociCommand}" CommandParameter="Natoil" AutomationProperties.Name="Ordina soci per nascita"/>
            <Button x:Name="ElencoSortCheckinTimeButton" Grid.Column="5" Classes="elencoSort" Content="{Binding ElencoCheckinTimeHeader}" Command="{Binding OrdinaSociCommand}" CommandParameter="CheckinTime" AutomationProperties.Name="Ordina soci per ingresso"/>
            <Button x:Name="ElencoSortGrb1Button" Grid.Column="6" Classes="elencoSort" Content="{Binding ElencoGrb1Header}" Command="{Binding OrdinaSociCommand}" CommandParameter="Grb1" AutomationProperties.Name="Ordina soci per grb 1"/>
            <Button x:Name="ElencoSortGrb2Button" Grid.Column="7" Classes="elencoSort" Content="{Binding ElencoGrb2Header}" Command="{Binding OrdinaSociCommand}" CommandParameter="Grb2" AutomationProperties.Name="Ordina soci per grb 2"/>
            <Button x:Name="ElencoSortGrb3Button" Grid.Column="8" Classes="elencoSort" Content="{Binding ElencoGrb3Header}" Command="{Binding OrdinaSociCommand}" CommandParameter="Grb3" AutomationProperties.Name="Ordina soci per grb 3"/>
            <Button x:Name="ElencoSortGrb4Button" Grid.Column="9" Classes="elencoSort" Content="{Binding ElencoGrb4Header}" Command="{Binding OrdinaSociCommand}" CommandParameter="Grb4" AutomationProperties.Name="Ordina soci per grb 4"/>
            <Button x:Name="ElencoSortConsumazioneButton" Grid.Column="10" Classes="elencoSort" Content="{Binding ElencoConsumazioneHeader}" Command="{Binding OrdinaSociCommand}" CommandParameter="Consumazione" AutomationProperties.Name="Ordina soci per consumazione"/>
            <Button x:Name="ElencoSortBloccoButton" Grid.Column="11" Classes="elencoSort" Content="{Binding ElencoBloccoHeader}" Command="{Binding OrdinaSociCommand}" CommandParameter="Blocco" AutomationProperties.Name="Ordina soci per blocco"/>
            <Button x:Name="ElencoSortNoteButton" Grid.Column="12" Classes="elencoSort" Content="{Binding ElencoNoteHeader}" Command="{Binding OrdinaSociCommand}" CommandParameter="Note" AutomationProperties.Name="Ordina soci per note"/>
          </Grid>
          <ListBox x:Name="SociList" Grid.Row="1" ItemsSource="{Binding Schede}" SelectedItem="{Binding SelectedScheda,Mode=TwoWay}"
           Background="Transparent" Padding="0" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
           ScrollViewer.VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Soci all'interno">
           <ListBox.Styles>
            <Style Selector="ListBoxItem">
             <Setter Property="Padding" Value="8,3"/>
             <Setter Property="Margin" Value="0"/>
             <Setter Property="MinHeight" Value="28"/>
             <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            </Style>
           </ListBox.Styles>
           <ListBox.ItemTemplate>
            <DataTemplate x:DataType="db:CassaScheda">
             <Grid ColumnDefinitions="80,125,125,105,95,150,50,50,50,50,115,90,180" ColumnSpacing="8" Height="24">
              <TextBlock Grid.Column="0" Text="{Binding Posizione}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip.Tip="{Binding Posizione}"/>
              <TextBlock Grid.Column="1" Text="{Binding Cognome}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip.Tip="{Binding Cognome}"/>
              <TextBlock Grid.Column="2" Text="{Binding Nome}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip.Tip="{Binding Nome}"/>
              <TextBlock Grid.Column="3" Text="{Binding NumeroTessera}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip.Tip="{Binding NumeroTessera}"/>
              <TextBlock Grid.Column="4" Text="{Binding Nascita}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip.Tip="{Binding Nascita}"/>
              <TextBlock Grid.Column="5" Text="{Binding CheckinTime, StringFormat='{}{0:dd/MM/yyyy HH:mm}'}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip.Tip="{Binding CheckinTime}"/>
              <TextBlock Grid.Column="6" Text="{Binding Grb1}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip.Tip="{Binding Grb1}"/>
              <TextBlock Grid.Column="7" Text="{Binding Grb2}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip.Tip="{Binding Grb2}"/>
              <TextBlock Grid.Column="8" Text="{Binding Grb3}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip.Tip="{Binding Grb3}"/>
              <TextBlock Grid.Column="9" Text="{Binding Grb4}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip.Tip="{Binding Grb4}"/>
              <TextBlock Grid.Column="10" Text="{Binding Consumazione, StringFormat='{}{0:0.00} €'}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip.Tip="{Binding Consumazione}"/>
              <Viewbox Grid.Column="11" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
               <CheckBox IsChecked="{Binding Blocco,Mode=OneWay}" IsHitTestVisible="False" Focusable="False" AutomationProperties.Name="Scheda bloccata"/>
              </Viewbox>
              <TextBlock Grid.Column="12" Text="{Binding Note}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip.Tip="{Binding Note}"/>
             </Grid>
            </DataTemplate>
           </ListBox.ItemTemplate>
          </ListBox>
         </Grid>
        </ScrollViewer>
       </Border>
       <TextBlock Grid.Row="3" Text="{Binding ResultText}" Foreground="White"/>
       <WrapPanel Grid.Row="4">
        <ui:UiIconButton XLabel="APRI SCHEDA" IconSymbol="Clipboard" IconVariant="Color" AutomationProperties.Name="Apri scheda selezionata"
         Command="{Binding OpenSelectedCommand}" Padding="12,8" Margin="0,0,12,8"/>
        <ui:UiIconButton XLabel="AGGIORNA" IconSymbol="ArrowSync" IconVariant="Color" AutomationProperties.Name="Aggiorna elenco soci"
         Command="{Binding RefreshListCommand}" Padding="12,8" Margin="0,0,12,8"/>
        <ui:UiIconButton XLabel="TORNA ALLA POSTAZIONE" IconSymbol="BuildingStore" IconVariant="Color"
         AutomationProperties.Name="Torna alla postazione" Command="{Binding BackCommand}" Padding="12,8" Margin="0,0,12,8"/>
       </WrapPanel>
      </Grid>
     </Grid>
      <views:AcquistoAbbonamentoView Grid.Row="2" IsVisible="{Binding IsAcquistoAbbonamento}" IsEnabled="{Binding IsUiReady}"/>
      <views:UscitaSocioView Grid.Row="2" IsVisible="{Binding IsUscita}" IsEnabled="{Binding IsUiReady}"/>
      <views:StoricoFidelityView Grid.Row="2" IsVisible="{Binding IsStoricoFidelity}" IsEnabled="{Binding IsUiReady}"/>
      <views:SospesiView Grid.Row="2" IsVisible="{Binding IsSospesi}" IsEnabled="{Binding IsUiReady}"/>
     <TextBlock Grid.Row="3" Text="{Binding InfoLabel}" Foreground="White" TextWrapping="Wrap"/>
     <Grid Grid.Row="2" IsVisible="{Binding IsBusy}" IsHitTestVisible="False">
      <ui:UiWaitIndicator Diameter="264" IsActive="{Binding IsBusy}" RotationSpeed="1.2" HorizontalAlignment="Center" VerticalAlignment="Center"/>
      <TextBlock Text="{Binding WaitMessage}" Foreground="White" MaxWidth="200" TextWrapping="Wrap" TextAlignment="Center"
       HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16"/>
     </Grid>
    </Grid>
  </ui:PopupBorder>
 </Grid>
</UserControl>
