<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:Cassa.ViewModels" xmlns:db="using:AppServices.Database" xmlns:ui="using:ControlStyles" x:Class="Cassa.Views.FidelityIngressoView" x:DataType="vm:CassaViewModel">
 <UserControl.Resources>
       <DataTemplate x:Key="TimbroFidelityTemplate" x:DataType="vm:TimbroIngressoFidelityViewModel">
        <StackPanel Width="96" Margin="0,0,8,10" Spacing="5">
         <Button Width="64" Height="64" CornerRadius="32" BorderThickness="2" HorizontalAlignment="Center"
          HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Background="{Binding Sfondo}" BorderBrush="{Binding Bordo}"
          IsEnabled="{Binding Corrente}" Command="{Binding $parent[UserControl].((vm:CassaViewModel)DataContext).TimbraERegistraIngressoCommand}"
          ToolTip.Tip="{Binding Aiuto}" AutomationProperties.Name="{Binding Numero,StringFormat='Timbro Fidelity {0}'}">
          <TextBlock Text="{Binding Simbolo}" FontSize="24" FontWeight="Bold" Foreground="#163E38"/>
         </Button>
         <TextBlock Text="{Binding Stato}" FontSize="11" TextAlignment="Center" TextWrapping="Wrap" Foreground="#475569"/>
        </StackPanel>
       </DataTemplate>
 </UserControl.Resources>
 <Border IsVisible="{Binding HasMember}" Background="#F8F3E7" BorderBrush="#D7C7A4" BorderThickness="2" CornerRadius="16" Padding="16">
  <StackPanel Spacing="8">
   <TextBlock Text="TESSERA FIDELITY" Foreground="#7C570B" FontSize="13" FontWeight="Bold" LetterSpacing="2"/>
   <StackPanel IsVisible="{Binding HasFidelity}" Spacing="6">
    <TextBlock Text="{Binding Fidelity.Nome}" FontSize="18" FontWeight="Bold" Foreground="#5D430A"/>
    <TextBlock Text="{Binding Fidelity.Progresso}" TextWrapping="Wrap"/>
    <TextBlock IsVisible="{Binding HasPremioFidelity}" Text="{Binding Fidelity.Premio}" TextWrapping="Wrap" FontWeight="Bold" Foreground="#166534"/>
    <TextBlock Text="{Binding Fidelity.Scadenza}"/>
    <TextBlock Text="{Binding ProssimoPremioFidelity}" FontSize="12" Foreground="#536B66" TextWrapping="Wrap"/>
    <ScrollViewer MaxHeight="250" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
     <ItemsControl ItemsSource="{Binding TimbriTesseraFidelity}" ItemTemplate="{StaticResource TimbroFidelityTemplate}" AutomationProperties.Name="Tessera timbri Fidelity">
      <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>

     </ItemsControl>
    </ScrollViewer>
    <TextBlock IsVisible="{Binding HasAltriSpaziFidelity}" Text="{Binding AltriSpaziFidelity}" Foreground="#536B66" FontSize="11" TextWrapping="Wrap"/>
    <TextBlock Text="{Binding TimbroIngressoFidelityInfo}" Foreground="#536B66" FontSize="12" TextWrapping="Wrap"/>

   </StackPanel>
   <TextBlock Text="Nessuna Fidelity attiva." IsVisible="{Binding !HasFidelity}"/>
   <StackPanel IsVisible="{Binding ShowActivateFidelity}" Spacing="6">
    <ComboBox ItemsSource="{Binding TipiFidelity}" SelectedItem="{Binding SelectedTipoFidelity,Mode=TwoWay}" HorizontalAlignment="Stretch">
     <ComboBox.ItemTemplate><DataTemplate x:DataType="db:CassaTipoFidelity"><TextBlock Text="{Binding Descrizione}" TextWrapping="Wrap"/></DataTemplate></ComboBox.ItemTemplate>
    </ComboBox>
    <ui:UiIconButton XLabel="ATTIVA FIDELITY" IconSymbol="AddCircle" IconVariant="Color" Command="{Binding AttivaFidelityCommand}" IsEnabled="{Binding CanActivateFidelity}" Padding="10,7" HorizontalAlignment="Left"/>
   </StackPanel>
   <ui:UiIconButton XLabel="INGRESSO FIDELITY" IconSymbol="PersonAdd" IconVariant="Color" Command="{Binding IngressoFidelityCommand}" IsVisible="{Binding ShowIngressoFidelity}" IsEnabled="{Binding CanIngressoFidelity}" Padding="10,7" HorizontalAlignment="Left"/>
   <CheckBox Content="{Binding CreditoFidelityLabel}" IsChecked="{Binding UsaCreditoFidelity,Mode=TwoWay}" IsVisible="{Binding ShowCreditoFidelity}" IsEnabled="{Binding CanSelectIngresso}"/>
  </StackPanel>
 </Border>
</UserControl>
