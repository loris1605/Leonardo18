<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="using:ControlStyles" xmlns:vm="using:Cassa.ViewModels" xmlns:db="using:AppServices.Database" x:Class="Cassa.Views.SospesiView" x:DataType="vm:CassaViewModel">
 <Grid RowDefinitions="Auto,Auto,*,Auto,Auto" RowSpacing="12">
  <TextBlock Text="SOSPESI" Foreground="White" FontSize="20" FontWeight="Bold"/>
  <WrapPanel Grid.Row="1">
   <ui:UiTextBox x:Name="SospesiCardBox" Text="{Binding TesseraFiltroSospesi,Mode=TwoWay}" PlaceholderText="Tessera del socio" MaxLength="30" Width="230" Margin="0,0,10,6" AutomationProperties.Name="Tessera ricerca sospesi"/>
   <ui:UiIconButton XLabel="CERCA SOCIO" IconSymbol="Search" IconVariant="Filled" Command="{Binding CercaSospesiCommand}" Padding="10,7" Margin="0,0,10,6"/>
   <ui:UiIconButton XLabel="MOSTRA TUTTI" IconSymbol="PeopleTeam" IconVariant="Color" Command="{Binding TuttiSospesiCommand}" Padding="10,7" Margin="0,0,10,6"/>
  </WrapPanel>
  <Border Grid.Row="2" Background="#F4F7FA" CornerRadius="8" Padding="12">
   <ScrollViewer x:Name="SospesiGridScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
    <StackPanel MinWidth="980" Spacing="8">
     <Grid ColumnDefinitions="130,240,*,100,180" ColumnSpacing="12">
      <TextBlock Text="DATA" FontWeight="Bold"/><TextBlock Grid.Column="1" Text="SOCI / TESSERE" FontWeight="Bold"/>
      <TextBlock Grid.Column="2" Text="DESCRIZIONE" FontWeight="Bold"/><TextBlock Grid.Column="3" Text="IMPORTO" FontWeight="Bold"/>
     </Grid>
     <ItemsControl ItemsSource="{Binding Sospesi}">
      <ItemsControl.ItemTemplate>
       <DataTemplate x:DataType="db:CassaSospeso">
        <Border BorderBrush="#CAD5E0" BorderThickness="0,0,0,1" Padding="0,10">
         <Grid ColumnDefinitions="130,240,*,100,180" ColumnSpacing="12">
          <TextBlock Text="{Binding DataOra,StringFormat='{}{0:dd/MM/yyyy HH:mm}'}" TextWrapping="Wrap"/>
          <StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="{Binding Soci}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Tessere}" FontSize="12" TextWrapping="Wrap"/></StackPanel>
          <StackPanel Grid.Column="2" Spacing="4"><TextBlock Text="{Binding Descrizione}" TextWrapping="Wrap"/><TextBlock Text="{Binding Origine}" FontSize="12"/><TextBlock Text="{Binding Tipo}" FontSize="12"/></StackPanel>
          <TextBlock Grid.Column="3" Text="{Binding Importo,StringFormat='{}{0:0.00} €'}" FontWeight="SemiBold"/>
          <ui:UiIconButton Grid.Column="4" XLabel="REGISTRA INCASSO" IconSymbol="Save" IconVariant="Filled" IsVisible="{Binding CanIncassare}" VerticalAlignment="Top" Padding="8,6"
           Command="{Binding $parent[UserControl].((vm:CassaViewModel)DataContext).IncassaSospesoCommand}" CommandParameter="{Binding}" AutomationProperties.Name="{Binding Descrizione,StringFormat='Incassa: {0}'}"/>
         </Grid>
        </Border>
       </DataTemplate>
      </ItemsControl.ItemTemplate>
     </ItemsControl>
    </StackPanel>
   </ScrollViewer>
  </Border>
  <TextBlock Grid.Row="3" Text="{Binding RiepilogoSospesi}" Foreground="White" FontWeight="SemiBold"/>
  <ui:UiIconButton Grid.Row="4" XLabel="TORNA INDIETRO" IconSymbol="BuildingStore" IconVariant="Color" Command="{Binding BackCommand}" HorizontalAlignment="Left" Padding="12,8"/>
 </Grid>
</UserControl>
