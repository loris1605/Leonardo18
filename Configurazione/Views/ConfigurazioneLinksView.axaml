<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:ui="using:ControlStyles" xmlns:vm="using:Configurazione.ViewModels"
 x:Class="Configurazione.Views.ConfigurazioneLinksView" x:DataType="vm:ConfigurazioneLinksViewModel">
 <Grid MinHeight="340">
  <StackPanel Spacing="12" IsVisible="{Binding !IsBusy}">
   <TextBlock Text="{Binding Title}" Foreground="White" FontWeight="Bold" FontSize="18" TextWrapping="Wrap"/>
   <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto">
    <ItemsControl ItemsSource="{Binding Scelte}">
     <ItemsControl.ItemTemplate>
      <DataTemplate x:DataType="vm:ConfigurazioneChoice">
       <CheckBox Content="{Binding Nome}" IsChecked="{Binding Selezionato,Mode=TwoWay}" Foreground="White" Margin="0,4"/>
      </DataTemplate>
     </ItemsControl.ItemTemplate>
    </ItemsControl>
   </ScrollViewer>
   <TextBlock Text="{Binding InfoLabel}" Foreground="White" TextWrapping="Wrap"/>
   <WrapPanel HorizontalAlignment="Center">
    <ui:UiIconButton Padding="10,7" XLabel="SALVA" Command="{Binding SaveCommand}" Margin="0,0,8,6" IconSymbol="Save" IconVariant="Filled"/>
    <ui:UiIconButton Padding="10,7" XLabel="ANNULLA" Command="{Binding CancelCommand}" Margin="0,0,0,6" IconSymbol="DismissCircle" IconVariant="Color"/>
   </WrapPanel>
  </StackPanel>
  <Grid IsVisible="{Binding IsBusy}" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
   <ui:UiWaitIndicator Diameter="264" IsActive="{Binding IsBusy}" RotationSpeed="1.2"/>
   <TextBlock Text="{Binding WaitMessage}" Foreground="White" MaxWidth="200" TextWrapping="Wrap"
    TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16"/>
  </Grid>
 </Grid>
</UserControl>

