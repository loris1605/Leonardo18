<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="using:ControlStyles" xmlns:vm="using:Report.ViewModels" xmlns:d="using:AppServices.Database" x:Class="Report.Views.ReportView" x:DataType="vm:ReportViewModel" Background="LightSteelBlue">
 <UserControl.KeyBindings><KeyBinding Gesture="Ctrl+P" Command="{Binding PrintCommand}"/><KeyBinding Gesture="Escape" Command="{Binding EscPressedCommand}"/><KeyBinding Gesture="F5" Command="{Binding RefreshCommand}"/></UserControl.KeyBindings>
 <UserControl.Styles><Style Selector="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="8,2"/></Style></UserControl.Styles>
 <Grid Margin="16"><ui:PopupBorder Padding="18" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
 <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto" RowSpacing="10">
  <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10"><ui:UiTitolo Text="Leonardo18 - REPORT" SubTitolo="True" FontSize="22"/><ui:UiIconButton Grid.Column="1" XLabel="STAMPA REPORT" IconSymbol="Print" IconVariant="Filled" AutomationProperties.Name="Stampa report" Command="{Binding PrintCommand}" IsEnabled="{Binding CanPrint}" Padding="12,8"/><ui:UiIconButton Grid.Column="2" XLabel="TORNA AL MENU" IconSymbol="Home" IconVariant="Color" Command="{Binding MenuCommand}" IsEnabled="{Binding IsReady}" Padding="12,8"/></Grid>
  <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" IsEnabled="{Binding IsReady}"><TextBlock Text="GIORNATA" Foreground="White" VerticalAlignment="Center"/><ComboBox Grid.Column="1" ItemsSource="{Binding Giornate}" SelectedItem="{Binding SelectedGiornata,Mode=TwoWay}" AutomationProperties.Name="Giornata report" HorizontalAlignment="Stretch"><ComboBox.ItemTemplate><DataTemplate x:DataType="d:ReportGiornata"><TextBlock Text="{Binding Label}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox><ui:UiIconButton Grid.Column="2" XLabel="VISUALIZZA / AGGIORNA" IconSymbol="ArrowSync" IconVariant="Color" Command="{Binding RefreshCommand}" Padding="12,8"/></Grid>
  <TextBlock Grid.Row="2" Text="{Binding Periodo}" Foreground="White"/>
  <UniformGrid Grid.Row="3" Columns="4" Rows="2"><Border Background="#F4F7FA" CornerRadius="8" Padding="12" Margin="4"><StackPanel Spacing="4"><TextBlock Text="INGRESSI" Foreground="#4B647C" FontSize="11"/><TextBlock Text="{Binding Data.Ingressi}" FontSize="24" FontWeight="SemiBold" Foreground="#17334E"/></StackPanel></Border>
<Border Background="#F4F7FA" CornerRadius="8" Padding="12" Margin="4"><StackPanel Spacing="4"><TextBlock Text="PRESENTI" Foreground="#4B647C" FontSize="11"/><TextBlock Text="{Binding Data.Presenti}" FontSize="24" FontWeight="SemiBold" Foreground="#17334E"/></StackPanel></Border>
<Border Background="#F4F7FA" CornerRadius="8" Padding="12" Margin="4"><StackPanel Spacing="4"><TextBlock Text="USCITE" Foreground="#4B647C" FontSize="11"/><TextBlock Text="{Binding Data.Uscite}" FontSize="24" FontWeight="SemiBold" Foreground="#17334E"/></StackPanel></Border>
<Border Background="#F4F7FA" CornerRadius="8" Padding="12" Margin="4"><StackPanel Spacing="4"><TextBlock Text="TOTALE OPERATIVO €" Foreground="#4B647C" FontSize="11"/><TextBlock Text="{Binding Data.TotaleOperativo, StringFormat={}{0:N2}}" FontSize="24" FontWeight="SemiBold" Foreground="#17334E"/></StackPanel></Border>
<Border Background="#F4F7FA" CornerRadius="8" Padding="12" Margin="4"><StackPanel Spacing="4"><TextBlock Text="PAGATO OPERATIVO €" Foreground="#4B647C" FontSize="11"/><TextBlock Text="{Binding Data.PagatoOperativo, StringFormat={}{0:N2}}" FontSize="24" FontWeight="SemiBold" Foreground="#17334E"/></StackPanel></Border>
<Border Background="#F4F7FA" CornerRadius="8" Padding="12" Margin="4"><StackPanel Spacing="4"><TextBlock Text="DA PAGARE OPERATIVO €" Foreground="#4B647C" FontSize="11"/><TextBlock Text="{Binding Data.DaPagareOperativo, StringFormat={}{0:N2}}" FontSize="24" FontWeight="SemiBold" Foreground="#17334E"/></StackPanel></Border>
<Border Background="#F4F7FA" CornerRadius="8" Padding="12" Margin="4"><StackPanel Spacing="4"><TextBlock Text="INCASSI CONTABILI €" Foreground="#4B647C" FontSize="11"/><TextBlock Text="{Binding Data.Incassi, StringFormat={}{0:N2}}" FontSize="24" FontWeight="SemiBold" Foreground="#17334E"/></StackPanel></Border>
<Border Background="#F4F7FA" CornerRadius="8" Padding="12" Margin="4"><StackPanel Spacing="4"><TextBlock Text="RICAVI CONTABILI €" Foreground="#4B647C" FontSize="11"/><TextBlock Text="{Binding Data.Ricavi, StringFormat={}{0:N2}}" FontSize="24" FontWeight="SemiBold" Foreground="#17334E"/></StackPanel></Border></UniformGrid>
  <TabControl Grid.Row="4" Background="#F4F7FA" IsVisible="{Binding HasData}" IsEnabled="{Binding IsReady}">
   <TabItem FontSize="12" Header="SETTORI"><Grid RowDefinitions="Auto,*" RowSpacing="6" Margin="8">
<Grid ColumnDefinitions="*,65,90,90,90,90,100" Margin="12,8"><TextBlock Text="NOME" FontWeight="Bold"/><TextBlock Grid.Column="1" Text="OPERAZIONI" FontSize="11"/><TextBlock Grid.Column="2" Text="LORDO €"/><TextBlock Grid.Column="3" Text="STORNI €"/><TextBlock Grid.Column="4" Text="NETTO €"/><TextBlock Grid.Column="5" Text="PAGATO €"/><TextBlock Grid.Column="6" Text="DA PAGARE €"/></Grid>
<ListBox Grid.Row="1" ItemsSource="{Binding Data.Settori}" Background="Transparent"><ListBox.ItemTemplate><DataTemplate x:DataType="d:ReportRiepilogo"><Grid ColumnDefinitions="*,65,90,90,90,90,100" Margin="4,8"><TextBlock Text="{Binding Nome}" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Column="1" Text="{Binding Operazioni}"/><TextBlock Grid.Column="2" Text="{Binding Lordo,StringFormat={}{0:N2}}"/><TextBlock Grid.Column="3" Text="{Binding Storni,StringFormat={}{0:N2}}"/><TextBlock Grid.Column="4" Text="{Binding Netto,StringFormat={}{0:N2}}" FontWeight="SemiBold"/><TextBlock Grid.Column="5" Text="{Binding Pagato,StringFormat={}{0:N2}}"/><TextBlock Grid.Column="6" Text="{Binding DaPagare,StringFormat={}{0:N2}}"/></Grid></DataTemplate></ListBox.ItemTemplate></ListBox></Grid></TabItem>
   <TabItem FontSize="12" Header="VOCI DI SPESA"><Grid RowDefinitions="Auto,*" Margin="8" RowSpacing="6">
    <Grid ColumnDefinitions="170,*,85,110,110,110" Margin="12,8"><TextBlock Text="SETTORE" FontWeight="Bold"/><TextBlock Grid.Column="1" Text="DETTAGLIO" FontWeight="Bold"/><TextBlock Grid.Column="2" Text="OPERAZIONI" FontSize="11"/><TextBlock Grid.Column="3" Text="NETTO €"/><TextBlock Grid.Column="4" Text="PAGATO €"/><TextBlock Grid.Column="5" Text="DA PAGARE €"/></Grid>
    <ListBox Grid.Row="1" ItemsSource="{Binding Data.Voci}" Background="Transparent"><ListBox.ItemTemplate><DataTemplate x:DataType="d:ReportVoce"><Grid ColumnDefinitions="170,*,85,110,110,110" Margin="4,8"><TextBlock Text="{Binding Settore}" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Column="1" Text="{Binding Descrizione}" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Column="2" Text="{Binding Operazioni}"/><TextBlock Grid.Column="3" Text="{Binding Totale,StringFormat={}{0:N2}}" FontWeight="SemiBold"/><TextBlock Grid.Column="4" Text="{Binding Pagato,StringFormat={}{0:N2}}"/><TextBlock Grid.Column="5" Text="{Binding DaPagare,StringFormat={}{0:N2}}"/></Grid></DataTemplate></ListBox.ItemTemplate></ListBox>
   </Grid></TabItem>
   <TabItem FontSize="12" Header="POSTAZIONI"><Grid RowDefinitions="Auto,*" RowSpacing="6" Margin="8">
<Grid ColumnDefinitions="*,65,90,90,90,90,100" Margin="12,8"><TextBlock Text="NOME" FontWeight="Bold"/><TextBlock Grid.Column="1" Text="OPERAZIONI" FontSize="11"/><TextBlock Grid.Column="2" Text="LORDO €"/><TextBlock Grid.Column="3" Text="STORNI €"/><TextBlock Grid.Column="4" Text="NETTO €"/><TextBlock Grid.Column="5" Text="PAGATO €"/><TextBlock Grid.Column="6" Text="DA PAGARE €"/></Grid>
<ListBox Grid.Row="1" ItemsSource="{Binding Data.Postazioni}" Background="Transparent"><ListBox.ItemTemplate><DataTemplate x:DataType="d:ReportRiepilogo"><Grid ColumnDefinitions="*,65,90,90,90,90,100" Margin="4,8"><TextBlock Text="{Binding Nome}" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Column="1" Text="{Binding Operazioni}"/><TextBlock Grid.Column="2" Text="{Binding Lordo,StringFormat={}{0:N2}}"/><TextBlock Grid.Column="3" Text="{Binding Storni,StringFormat={}{0:N2}}"/><TextBlock Grid.Column="4" Text="{Binding Netto,StringFormat={}{0:N2}}" FontWeight="SemiBold"/><TextBlock Grid.Column="5" Text="{Binding Pagato,StringFormat={}{0:N2}}"/><TextBlock Grid.Column="6" Text="{Binding DaPagare,StringFormat={}{0:N2}}"/></Grid></DataTemplate></ListBox.ItemTemplate></ListBox></Grid></TabItem>
   <TabItem FontSize="12" Header="CONTABILITÀ"><Grid RowDefinitions="Auto,Auto,Auto,*" RowSpacing="10" Margin="12">
    <TextBlock Text="Scritture confermate della giornata. Incassi e pagato operativo rappresentano dati distinti." TextWrapping="Wrap"/>
    <WrapPanel Grid.Row="1"><TextBlock Text="{Binding Data.Costi,StringFormat='Costi: {0:N2} €'}" Margin="0,0,24,0"/><TextBlock Text="{Binding Data.UsciteMonetarie,StringFormat='Uscite monetarie: {0:N2} €'}" Margin="0,0,24,0"/><TextBlock Text="{Binding Data.SaldoMonetario,StringFormat='Saldo Cassa + Banca: {0:N2} €'}" FontWeight="Bold"/></WrapPanel>
    <Grid Grid.Row="2" ColumnDefinitions="*,160,160,160"><TextBlock Text="SETTORE" FontWeight="Bold"/><TextBlock Grid.Column="1" Text="RICAVI €"/><TextBlock Grid.Column="2" Text="COSTI €"/><TextBlock Grid.Column="3" Text="DIFFERENZA €"/></Grid>
    <ListBox Grid.Row="3" ItemsSource="{Binding Data.Contabilita}" Background="Transparent"><ListBox.ItemTemplate><DataTemplate x:DataType="d:ReportContabilita"><Grid ColumnDefinitions="*,160,160,160" Margin="0,8"><TextBlock Text="{Binding Settore}"/><TextBlock Grid.Column="1" Text="{Binding Ricavi,StringFormat={}{0:N2}}"/><TextBlock Grid.Column="2" Text="{Binding Costi,StringFormat={}{0:N2}}"/><TextBlock Grid.Column="3" Text="{Binding Margine,StringFormat={}{0:N2}}" FontWeight="SemiBold"/></Grid></DataTemplate></ListBox.ItemTemplate></ListBox>
   </Grid></TabItem>
   <TabItem FontSize="12" Header="SOSPESI / ABB."><Grid Margin="14" ColumnDefinitions="*,*" ColumnSpacing="24">
    <StackPanel Spacing="8"><TextBlock Text="SOSPESI" FontSize="16" FontWeight="Bold"/><TextBlock Text="Situazione alla fine del periodo" FontSize="12"/>
     <TextBlock Text="{Binding Data.NumeroSospesi,StringFormat='Voci aperte: {0}'}"/><TextBlock Text="{Binding Data.SospesiCrediti,StringFormat='Crediti da incassare: {0:N2} €'}"/>
     <TextBlock Text="{Binding Data.SospesiDebiti,StringFormat='Debiti da pagare: {0:N2} €'}"/><TextBlock Text="{Binding Data.SospesiIncassati,StringFormat='Incassati nel periodo: {0:N2} €'}"/>
    </StackPanel>
    <StackPanel Grid.Column="1" Spacing="8"><TextBlock Text="ABBONAMENTI" FontSize="16" FontWeight="Bold"/><TextBlock Text="Acquisti nel periodo" FontSize="12"/>
     <TextBlock Text="{Binding Data.AbbonamentiVenduti,StringFormat='Acquisti: {0}'}"/><TextBlock Text="{Binding Data.ValoreAbbonamenti,StringFormat='Valore acquisti: {0:N2} €'}"/>
     <TextBlock Text="Il valore comprende acquisti pagati e non pagati. I sospesi includono anche le giornate precedenti." TextWrapping="Wrap" FontSize="12"/>
    </StackPanel>
   </Grid></TabItem>
  </TabControl>
  <TextBlock Grid.Row="5" Text="{Binding InfoLabel}" Foreground="White" TextWrapping="Wrap"/>
 </Grid></ui:PopupBorder>
 <Border IsVisible="{Binding IsBusy}" Background="#AA324860" CornerRadius="12"><ui:UiWaitIndicator Diameter="160" IsActive="{Binding IsBusy}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
 </Grid>
</UserControl>